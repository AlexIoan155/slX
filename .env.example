# --- Supabase (required) ---------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the client or commit it.
# Used by the admin client (services/subscription.service.ts, notifications).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------
# Used to build absolute URLs (email redirects, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (optional - leave unset to keep billing dormant) ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
